# Copy to .env and fill in. Never commit .env.

# --- Models: "provider:model" strings, see https://docs.langchain.com/oss/python/integrations/chat
CHAT_MODEL=openai:gpt-5-mini
SMALL_MODEL=openai:gpt-5-nano
FALLBACK_MODEL=openai:gpt-5-nano
EMBEDDING_MODEL=openai:text-embedding-3-small
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Services (docker compose service names; use localhost when running outside Docker)
QDRANT_URL=http://localhost:6333
QDRANT_ALIAS=docs_live
# Leave empty to run with in-memory state (nothing survives a restart):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# --- App
APP_ENV=dev                 # "prod" refuses to start with the default API key
API_KEY=dev-key
API_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=20

# --- Optional tools (each one is skipped when its setting is empty)
TAVILY_API_KEY=
GITHUB_MCP_URL=             # a read-only GitHub MCP server URL
GITHUB_MCP_TOKEN=
FILE_ISSUE_REPO=            # owner/repo; enables the approval-gated file_issue tool
FILE_ISSUE_TOKEN=
ISSUE_FILER_IDS=            # comma-separated user ids allowed to see file_issue

# --- Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docs-copilot

# --- Production only (docker-compose.yml). See docs/08-deploy-aws.md
POSTGRES_PASSWORD=copilot
DOMAIN=                      # your domain for automatic HTTPS; empty means plain HTTP on :80
BASIC_AUTH_USER=
BASIC_AUTH_HASH=             # docker run --rm caddy caddy hash-password  (write each $ as $$)
MCP_DOCS_TOKEN=              # optional bearer token for the docs MCP server
